---
const projects = [
  {
    number: "01",
    title: "DIGITAL PLATFORM",
    category: "WEB / SOFTWARE",
    description:
      "A modern digital platform engineered for performance, scalability and exceptional user experience.",
    image: "/images/project-01.jpg",
  },
  {
    number: "02",
    title: "AI SYSTEM",
    category: "AI / AUTOMATION",
    description:
      "An intelligent AI system designed to automate workflows and transform business operations.",
    image: "/images/project-02.jpg",
  },
  {
    number: "03",
    title: "E-COMMERCE",
    category: "DIGITAL / COMMERCE",
    description:
      "A premium commerce experience combining modern interaction design with scalable technology.",
    image: "/images/project-03.jpg",
  },
  {
    number: "04",
    title: "BUSINESS SYSTEM",
    category: "SOFTWARE / DATA",
    description:
      "A powerful business system connecting data, workflows and decision-making into one platform.",
    image: "/images/project-04.jpg",
  },
];
---

<section class="work" id="work">

  <!-- =========================================
       HEADER
  ========================================== -->

  <div class="work-header">

    <span>02</span>

    <span>SELECTED WORK</span>

    <span>04 PROJECTS</span>

  </div>


  <!-- =========================================
       INTRO
  ========================================== -->

  <div class="work-intro">

    <div class="work-title">

      <span class="title-small">
        SELECTED
      </span>

      <h2>
        DIGITAL
        <span>WORK.</span>
      </h2>

    </div>


    <div class="work-description">

      <p>
        Digital products, intelligent systems
        and immersive experiences engineered
        by HEPTA.
      </p>

      <div class="work-hint">
        <span>DRAG / SCROLL</span>
        <span>↔</span>
      </div>

    </div>

  </div>


  <!-- =========================================
       3D STAGE
  ========================================== -->

  <div
    class="work-stage"
    data-work-stage
  >

    <div
      class="carousel"
      data-carousel
    >

      {
        projects.map((project, index) => (
          <article
            class="project-card"
            data-project
            data-index={index}
            data-image={project.image}
          >

            <div class="card-image">

              <img
                src={project.image}
                alt={project.title}
                loading="lazy"
              />

              <div class="image-overlay"></div>

            </div>


            <div class="card-number">
              {project.number}
            </div>


            <div class="card-info">

              <div class="card-category">
                {project.category}
              </div>

              <h3>
                {project.title}
              </h3>

              <p>
                {project.description}
              </p>

            </div>


            <div class="card-arrow">
              ↗
            </div>


            <div class="card-progress">
              <span></span>
            </div>

          </article>
        ))
      }

    </div>


    <!-- =======================================
         CENTER POINT
    ======================================== -->

    <div class="stage-center">

      <span></span>

    </div>


    <!-- =======================================
         STAGE GRID
    ======================================== -->

    <div class="stage-grid"></div>

  </div>


  <!-- =========================================
       CONTROLS
  ========================================== -->

  <div class="work-controls">

    <div class="control-left">

      <span class="active-number">
        01
      </span>

      <span>/</span>

      <span>
        04
      </span>

    </div>


    <div class="control-center">

      <span class="control-line"></span>

      <span>
        EXPLORE PROJECTS
      </span>

      <span class="control-line"></span>

    </div>


    <button
      class="next-project"
      type="button"
      aria-label="Next project"
      data-next
    >
      <span>↗</span>
    </button>

  </div>


  <!-- =========================================
       BOTTOM STATEMENT
  ========================================== -->

  <div class="work-bottom">

    <span></span>

    <p>
      ENGINEERING
      <strong>
        DIGITAL FUTURES.
      </strong>
    </p>

  </div>

</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initWork = () => {
    const section = document.querySelector(".work");

    if (!section) return;

    const stage = section.querySelector("[data-work-stage]");
    const carousel = section.querySelector("[data-carousel]");
    const cards = [...section.querySelectorAll("[data-project]")];
    const nextButton = section.querySelector("[data-next]");
    const activeNumber = section.querySelector(".active-number");

    if (!stage || !carousel || !cards.length) return;

    const total = cards.length;
    const angle = 360 / total;

    let targetRotation = 0;
    let currentRotation = 0;

    let isDragging = false;
    let startX = 0;
    let startRotation = 0;

    let mouseX = 0;
    let mouseY = 0;

    let smoothMouseX = 0;
    let smoothMouseY = 0;

    let animationFrame;


    /* =========================================
       RESPONSIVE RADIUS
    ========================================== */

    const getRadius = () => {
      if (window.innerWidth <= 768) {
        return 285;
      }

      if (window.innerWidth <= 1000) {
        return 350;
      }

      return 470;
    };


    /* =========================================
       NORMALIZE ANGLE
    ========================================== */

    const normalizeAngle = (value) => {
      let result = value % 360;

      if (result > 180) {
        result -= 360;
      }

      if (result < -180) {
        result += 360;
      }

      return result;
    };


    /* =========================================
       UPDATE CARDS
    ========================================== */

    const updateCards = () => {
      const radius = getRadius();

      cards.forEach((card, index) => {
        const cardAngle =
          index * angle + currentRotation;

        const radians =
          (cardAngle * Math.PI) / 180;

        const x =
          Math.sin(radians) * radius;

        const z =
          Math.cos(radians) * radius;

        const normalized =
          normalizeAngle(cardAngle);

        const depth =
          (z + radius) / (radius * 2);

        const distance =
          Math.abs(normalized);

        /*
         * Active card becomes larger
         */
        const activeAmount =
          1 - Math.min(distance / 180, 1);

        const scale =
          0.72 +
          depth * 0.20 +
          activeAmount * 0.08;

        const opacity =
          0.22 +
          depth * 0.58 +
          activeAmount * 0.20;

        const blur =
          Math.min(distance / 90, 1) * 2.5;

        gsap.set(card, {
          x,
          z,
          scale,
          opacity,
          rotateY: -cardAngle,
          filter:
            `blur(${blur}px)`,
          zIndex:
            Math.round(
              1000 + z
            ),
        });
      });
    };


    /* =========================================
       ACTIVE PROJECT
    ========================================== */

    const updateActive = () => {
      let closestIndex = 0;
      let closestDistance = Infinity;

      cards.forEach((card, index) => {
        const cardAngle =
          index * angle +
          currentRotation;

        const normalized =
          normalizeAngle(cardAngle);

        const distance =
          Math.abs(normalized);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      if (activeNumber) {
        activeNumber.textContent =
          String(
            closestIndex + 1
          ).padStart(2, "0");
      }

      cards.forEach((card, index) => {
        card.classList.toggle(
          "is-active",
          index === closestIndex
        );
      });
    };


    /* =========================================
       MAIN ANIMATION
    ========================================== */

    const animate = () => {
      currentRotation +=
        (
          targetRotation -
          currentRotation
        ) * 0.085;

      smoothMouseX +=
        (
          mouseX -
          smoothMouseX
        ) * 0.08;

      smoothMouseY +=
        (
          mouseY -
          smoothMouseY
        ) * 0.08;


      updateCards();


      /*
       * Parallax only affects
       * the whole carousel.
       */
      gsap.set(carousel, {
        rotateX:
          -smoothMouseY * 5,

        rotateY:
          smoothMouseX * 8,
      });


      updateActive();

      animationFrame =
        requestAnimationFrame(
          animate
        );
    };


    updateCards();
    updateActive();
    animate();


    /* =========================================
       NEXT
    ========================================== */

    const goNext = () => {
      targetRotation -= angle;
    };


    nextButton?.addEventListener(
      "click",
      goNext
    );


    /* =========================================
       WHEEL
    ========================================== */

    stage.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();

        if (Math.abs(event.deltaY) < 2) {
          return;
        }

        const direction =
          event.deltaY > 0
            ? -1
            : 1;

        targetRotation +=
          direction * angle;
      },
      {
        passive: false,
      }
    );


    /* =========================================
       POINTER DOWN
    ========================================== */

    stage.addEventListener(
      "pointerdown",
      (event) => {
        isDragging = true;

        startX =
          event.clientX;

        startRotation =
          targetRotation;

        stage.setPointerCapture(
          event.pointerId
        );

        stage.classList.add(
          "is-dragging"
        );
      }
    );


    /* =========================================
       POINTER MOVE
    ========================================== */

    stage.addEventListener(
      "pointermove",
      (event) => {
        if (!isDragging) return;

        const difference =
          event.clientX -
          startX;

        targetRotation =
          startRotation +
          difference * 0.55;
      }
    );


    /* =========================================
       SNAP TO CARD
    ========================================== */

    const snapToNearest = () => {
      const nearest =
        Math.round(
          targetRotation /
          angle
        );

      targetRotation =
        nearest * angle;
    };


    /* =========================================
       POINTER UP
    ========================================== */

    const stopDragging = () => {
      if (!isDragging) return;

      isDragging = false;

      stage.classList.remove(
        "is-dragging"
      );

      snapToNearest();
    };


    stage.addEventListener(
      "pointerup",
      stopDragging
    );

    stage.addEventListener(
      "pointercancel",
      stopDragging
    );

    stage.addEventListener(
      "lostpointercapture",
      stopDragging
    );


    /* =========================================
       MOUSE PARALLAX
    ========================================== */

    stage.addEventListener(
      "pointermove",
      (event) => {
        const rect =
          stage.getBoundingClientRect();

        mouseX =
          (
            event.clientX -
            rect.left
          ) /
            rect.width -
          0.5;

        mouseY =
          (
            event.clientY -
            rect.top
          ) /
            rect.height -
          0.5;
      }
    );


    stage.addEventListener(
      "pointerleave",
      () => {
        mouseX = 0;
        mouseY = 0;
      }
    );


    /* =========================================
       CARD HOVER
    ========================================== */

    cards.forEach((card) => {
      const image =
        card.querySelector(
          ".card-image img"
        );

      const arrow =
        card.querySelector(
          ".card-arrow"
        );

      card.addEventListener(
        "mouseenter",
        () => {
          if (image) {
            gsap.to(image, {
              scale: 1.04,
              duration: 1.2,
              ease: "power3.out",
              overwrite: true,
            });
          }

          if (arrow) {
            gsap.to(arrow, {
              rotation: 45,
              duration: 0.5,
              ease: "power3.out",
            });
          }
        }
      );


      card.addEventListener(
        "mouseleave",
        () => {
          if (image) {
            gsap.to(image, {
              scale: 1,
              duration: 1,
              ease: "power3.out",
              overwrite: true,
            });
          }

          if (arrow) {
            gsap.to(arrow, {
              rotation: 0,
              duration: 0.5,
              ease: "power3.out",
            });
          }
        }
      );
    });


    /* =========================================
       INTRO REVEAL
    ========================================== */

    const header =
      section.querySelector(
        ".work-header"
      );

    const intro =
      section.querySelector(
        ".work-intro"
      );

    const controls =
      section.querySelector(
        ".work-controls"
      );

    const bottom =
      section.querySelector(
        ".work-bottom"
      );


    if (header) {
      gsap.fromTo(
        header,
        {
          y: 30,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 0.4,
          duration: 1,
          ease: "power4.out",

          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
        }
      );
    }


    if (intro) {
      gsap.fromTo(
        intro,
        {
          y: 80,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 1,
          duration: 1.2,
          ease: "power4.out",

          scrollTrigger: {
            trigger: intro,
            start: "top 85%",
            once: true,
          },
        }
      );
    }


    /* =========================================
       CARD ENTRANCE
    ========================================== */

    gsap.fromTo(
      cards,
      {
        scale: 0.6,
        opacity: 0,
        z: -400,
      },
      {
        scale: 1,
        opacity: 1,
        z: 0,
        duration: 1.4,
        stagger: 0.08,
        ease: "power4.out",

        scrollTrigger: {
          trigger: stage,
          start: "top 80%",
          once: true,
        },

        onUpdate: () => {
          updateCards();
        },
      }
    );


    /* =========================================
       CONTROLS REVEAL
    ========================================== */

    if (controls) {
      gsap.fromTo(
        controls,
        {
          y: 35,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 1,
          duration: 0.9,
          ease: "power3.out",

          scrollTrigger: {
            trigger: stage,
            start: "top 65%",
            once: true,
          },
        }
      );
    }


    /* =========================================
       BOTTOM REVEAL
    ========================================== */

    if (bottom) {
      gsap.fromTo(
        bottom,
        {
          y: 30,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 0.3,
          duration: 0.8,
          ease: "power3.out",

          scrollTrigger: {
            trigger: bottom,
            start: "top 90%",
            once: true,
          },
        }
      );
    }


    /* =========================================
       RESIZE
    ========================================== */

    const handleResize = () => {
      updateCards();
      ScrollTrigger.refresh();
    };


    window.addEventListener(
      "resize",
      handleResize
    );


    /* =========================================
       REDUCED MOTION
    ========================================== */

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      );


    if (reducedMotion.matches) {
      targetRotation = 0;
      currentRotation = 0;
    }
  };


  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initWork,
      {
        once: true,
      }
    );
  } else {
    initWork();
  }
</script>

<style>
  /* =========================================
     SECTION
  ========================================== */

  .work {
    position: relative;

    min-height: 100vh;

    padding:
      140px 7vw
      80px;

    background:
      #050505;

    color: white;

    border-top:
      1px solid
      rgba(
        255,
        255,
        255,
        0.12
      );

    overflow: hidden;

    perspective:
      1800px;
  }


  /* =========================================
     HEADER
  ========================================== */

  .work-header {
    display: flex;

    justify-content:
      space-between;

    align-items:
      center;

    margin-bottom:
      6vw;

    font-size:
      9px;

    letter-spacing:
      0.2em;

    opacity:
      0.4;
  }


  /* =========================================
     INTRO
  ========================================== */

  .work-intro {
    display: flex;

    justify-content:
      space-between;

    align-items: flex-end;

    position: relative;

    z-index: 5;

    margin-bottom:
      40px;
  }


  .title-small {
    display: block;

    margin-bottom:
      20px;

    font-size:
      9px;

    letter-spacing:
      0.2em;

    opacity:
      0.35;
  }


  .work-title h2 {
    margin: 0;

    font-size:
      clamp(
        70px,
        11vw,
        180px
      );

    line-height:
      0.78;

    letter-spacing:
      -0.08em;

    font-weight:
      500;
  }


  .work-title h2 span {
    opacity:
      0.22;
  }


  .work-description {
    width:
      290px;

    margin-bottom:
      10px;
  }


  .work-description p {
    margin: 0;

    font-size:
      12px;

    line-height:
      1.7;

    opacity:
      0.4;
  }


  .work-hint {
    display: flex;

    justify-content:
      space-between;

    margin-top:
      35px;

    padding-top:
      12px;

    border-top:
      1px solid
      rgba(
        255,
        255,
        255,
        0.15
      );

    font-size:
      8px;

    letter-spacing:
      0.16em;

    opacity:
      0.3;
  }


  /* =========================================
     3D STAGE
  ========================================== */

  .work-stage {
    position: relative;

    width: 100%;

    height:
      min(
        650px,
        55vw
      );

    min-height:
      500px;

    display: flex;

    align-items:
      center;

    justify-content:
      center;

    perspective:
      1400px;

    cursor:
      grab;

    touch-action:
      pan-y;

    user-select:
      none;
  }


  .work-stage:active {
    cursor:
      grabbing;
  }


  /* =========================================
     GRID
  ========================================== */

  .stage-grid {
    position: absolute;

    inset:
      15% 10%;

    pointer-events:
      none;

    opacity:
      0.12;

    background-image:
      linear-gradient(
        rgba(
          255,
          255,
          255,
          0.15
        )
        1px,
        transparent
        1px
      ),
      linear-gradient(
        90deg,
        rgba(
          255,
          255,
          255,
          0.15
        )
        1px,
        transparent
        1px
      );

    background-size:
      70px 70px;

    mask-image:
      radial-gradient(
        ellipse,
        black 0%,
        transparent 70%
      );
  }


  /* =========================================
     CAROUSEL
  ========================================== */

  .carousel {
    position: relative;

    width:
      430px;

    height:
      560px;

    transform-style:
      preserve-3d;

    will-change:
      transform;

    z-index:
      3;
  }


  /* =========================================
     PROJECT CARD
  ========================================== */

  .project-card {
    position: absolute;

    top: 0;
    left: 0;

    width:
      430px;

    height:
      560px;

    overflow:
      hidden;

    background:
      #111;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.18
      );

    transform-style:
      preserve-3d;

    backface-visibility:
      hidden;

    will-change:
      transform,
      opacity;

    cursor:
      pointer;

    transition:
      border-color
      0.5s ease;
  }


  .project-card.is-active {
    border-color:
      rgba(
        255,
        255,
        255,
        0.45
      );
  }


  /* =========================================
     IMAGE
  ========================================== */

  .card-image {
    position: absolute;

    inset:
      0;

    overflow:
      hidden;
  }


  .card-image img {
    width:
      100%;

    height:
      100%;

    display:
      block;

    object-fit:
      cover;

    transform:
      scale(1.08);

    filter:
      saturate(0.7);

    transition:
      transform
      1s cubic-bezier(
        0.16,
        1,
        0.3,
        1
      ),

      filter
      0.8s ease;
  }


  .project-card:hover
  .card-image img,

  .project-card.is-active
  .card-image img {
    transform:
      scale(1);

    filter:
      saturate(1);
  }


  .image-overlay {
    position: absolute;

    inset:
      0;

    background:
      linear-gradient(
        180deg,
        rgba(
          0,
          0,
          0,
          0.05
        )
        20%,
        rgba(
          0,
          0,
          0,
          0.15
        )
        45%,
        rgba(
          0,
          0,
          0,
          0.9
        )
        100%
      );
  }


  /* =========================================
     CARD NUMBER
  ========================================== */

  .card-number {
    position: absolute;

    top:
      25px;

    left:
      25px;

    font-size:
      9px;

    letter-spacing:
      0.15em;

    opacity:
      0.7;
  }


  /* =========================================
     CARD INFO
  ========================================== */

  .card-info {
    position: absolute;

    left:
      30px;

    right:
      30px;

    bottom:
      45px;

    transform:
      translateZ(40px);
  }


  .card-category {
    margin-bottom:
      18px;

    font-size:
      8px;

    letter-spacing:
      0.18em;

    opacity:
      0.6;
  }


  .card-info h3 {
    margin: 0;

    font-size:
      clamp(
        32px,
        4vw,
        55px
      );

    line-height:
      0.85;

    letter-spacing:
      -0.06em;

    font-weight:
      400;
  }


  .card-info p {
    max-width:
      300px;

    margin:
      18px 0 0;

    font-size:
      10px;

    line-height:
      1.6;

    opacity:
      0.55;
  }


  /* =========================================
     ARROW
  ========================================== */

  .card-arrow {
    position: absolute;

    top:
      22px;

    right:
      22px;

    width:
      42px;

    height:
      42px;

    display: flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.35
      );

    border-radius:
      50%;

    font-size:
      16px;

    transform:
      translateZ(50px);

    transition:
      transform
      0.5s ease,
      background
      0.5s ease;
  }


  .project-card:hover
  .card-arrow {
    transform:
      translateZ(50px)
      rotate(45deg);

    background:
      rgba(
        255,
        255,
        255,
        0.12
      );
  }


  /* =========================================
     PROGRESS
  ========================================== */

  .card-progress {
    position: absolute;

    left:
      30px;

    right:
      30px;

    bottom:
      20px;

    height:
      1px;

    background:
      rgba(
        255,
        255,
        255,
        0.2
      );
  }


  .card-progress span {
    display: block;

    width:
      100%;

    height:
      100%;

    transform:
      scaleX(0);

    transform-origin:
      left;

    background:
      white;

    transition:
      transform
      0.8s ease;
  }


  .project-card.is-active
  .card-progress span {
    transform:
      scaleX(1);
  }


  /* =========================================
     CENTER POINT
  ========================================== */

  .stage-center {
    position: absolute;

    left:
      50%;

    top:
