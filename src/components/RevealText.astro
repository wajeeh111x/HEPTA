---

<div class="reveal-wrapper">
  <div class="reveal-text">
    <slot />
  </div>
</div>

<style>
  .reveal-wrapper {
    overflow: hidden;
  }

  .reveal-text {
    will-change: transform, opacity;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const elements =
    document.querySelectorAll(
      ".reveal-text"
    );

  elements.forEach((element) => {

    gsap.fromTo(
      element,
      {
        yPercent: 110,
        opacity: 0,
      },
      {
        yPercent: 0,
        opacity: 1,

        duration: 1.2,

        ease:
          "power4.out",

        scrollTrigger: {

          trigger:
            element,

          start:
            "top 90%",

          once:
            true,

        },
      }
    );

  });
</script>