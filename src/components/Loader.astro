---
---

<div id="hepta-loader" class="loader">

  <!-- Background -->
  <div class="loader-grid"></div>

  <!-- Ambient particles -->
  <div class="particles">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="loader-inner">

    <!-- TOP -->
    <div class="loader-top">

      <div class="loader-brand">
        HEPTA
      </div>

      <div class="loader-status">
        SYSTEM / <span>ONLINE</span>
      </div>

    </div>


    <!-- 3D CORE -->
    <div class="loader-center">

      <div class="scene">

        <div class="core">

          <div class="core-ring ring-1"></div>
          <div class="core-ring ring-2"></div>
          <div class="core-ring ring-3"></div>

          <div class="core-orbit orbit-1"></div>
          <div class="core-orbit orbit-2"></div>

          <div class="core-sphere">

            <div class="sphere-line line-1"></div>
            <div class="sphere-line line-2"></div>
            <div class="sphere-line line-3"></div>
            <div class="sphere-line line-4"></div>

            <div class="sphere-dot"></div>

          </div>

          <div class="core-glow"></div>

        </div>

      </div>


      <!-- LOGO -->
      <div class="loader-logo">
        HEPTA
      </div>


      <!-- PROGRESS -->
      <div class="loader-progress-wrapper">

        <div
          id="loader-progress"
          class="loader-progress"
        ></div>

      </div>


      <div class="loader-info">

        <span>
          INITIALIZING DIGITAL EXPERIENCE
        </span>

        <span id="loader-percent">
          0%
        </span>

      </div>

    </div>


    <!-- BOTTOM -->
    <div class="loader-bottom">

      <span>
        SOFTWARE
      </span>

      <span>
        ARTIFICIAL INTELLIGENCE
      </span>

      <span>
        IMMERSIVE TECHNOLOGY
      </span>

      <span>
        2026
      </span>

    </div>

  </div>

</div>


<script>
  import gsap from "gsap";

  function startLoader() {

    const loader =
      document.getElementById(
        "hepta-loader"
      );

    const progress =
      document.getElementById(
        "loader-progress"
      );

    const percent =
      document.getElementById(
        "loader-percent"
      );

    if (
      !loader ||
      !progress ||
      !percent
    ) {
      return;
    }


    /*
     * Prevent duplicate initialization
     */

    if (
      loader.dataset.loaded === "true"
    ) {
      return;
    }

    loader.dataset.loaded = "true";


    /*
     * Initial state
     */

    gsap.set(
      loader,
      {
        display: "block",
        opacity: 1,
        clipPath:
          "inset(0% 0% 0% 0%)",
      }
    );


    gsap.set(
      ".loader-logo",
      {
        y: 80,
        opacity: 0,
      }
    );


    gsap.set(
      ".scene",
      {
        opacity: 0,
        scale: 0.65,
        rotationX: 25,
        rotationY: -25,
      }
    );


    gsap.set(
      ".loader-progress-wrapper",
      {
        opacity: 0,
        scaleX: 0.7,
      }
    );


    gsap.set(
      ".loader-info",
      {
        opacity: 0,
      }
    );


    gsap.set(
      ".loader-top",
      {
        y: -20,
        opacity: 0,
      }
    );


    gsap.set(
      ".loader-bottom",
      {
        y: 20,
        opacity: 0,
      }
    );


    /*
     * Entrance
     */

    const entrance =
      gsap.timeline();


    entrance.to(
      ".loader-top",
      {
        y: 0,
        opacity: 1,

        duration: 0.7,

        ease:
          "power3.out",
      }
    );


    entrance.to(
      ".scene",
      {
        opacity: 1,
        scale: 1,
        rotationX: 0,
        rotationY: 0,

        duration: 1.4,

        ease:
          "power4.out",
      },
      "-=0.35"
    );


    entrance.to(
      ".loader-logo",
      {
        y: 0,
        opacity: 1,

        duration: 1,

        ease:
          "power4.out",
      },
      "-=0.7"
    );


    entrance.to(
      ".loader-progress-wrapper",
      {
        opacity: 1,
        scaleX: 1,

        duration: 0.6,

        ease:
          "power3.out",
      },
      "-=0.45"
    );


    entrance.to(
      ".loader-info",
      {
        opacity: 0.4,

        duration: 0.4,
      },
      "-=0.25"
    );


    entrance.to(
      ".loader-bottom",
      {
        y: 0,
        opacity: 0.35,

        duration: 0.6,

        ease:
          "power3.out",
      },
      "-=0.35"
    );


    /*
     * Core rotation
     */

    gsap.to(
      ".ring-1",
      {
        rotationZ: 360,

        duration: 7,

        repeat: -1,

        ease: "none",
      }
    );


    gsap.to(
      ".ring-2",
      {
        rotationY: 360,

        duration: 10,

        repeat: -1,

        ease: "none",
      }
    );


    gsap.to(
      ".ring-3",
      {
        rotationX: 360,

        duration: 13,

        repeat: -1,

        ease: "none",
      }
    );


    gsap.to(
      ".orbit-1",
      {
        rotation: 360,

        duration: 8,

        repeat: -1,

        ease: "none",
      }
    );


    gsap.to(
      ".orbit-2",
      {
        rotation: -360,

        duration: 11,

        repeat: -1,

        ease: "none",
      }
    );


    /*
     * Sphere breathing
     */

    gsap.to(
      ".core-sphere",
      {
        scale: 1.08,

        duration: 2,

        repeat: -1,

        yoyo: true,

        ease:
          "sine.inOut",
      }
    );


    /*
     * Progress
     */

    const progressObject = {
      value: 0,
    };


    gsap.to(
      progressObject,
      {
        value: 100,

        duration: 3.2,

        ease:
          "power2.inOut",

        onUpdate: () => {

          const value =
            Math.round(
              progressObject.value
            );


          percent.textContent =
            `${value}%`;


          progress.style.width =
            `${value}%`;

        },


        onComplete: () => {

          finishLoader();

        },

      }
    );


    /*
     * Mouse interaction
     */

    const mouse = {
      x: 0,
      y: 0,
    };


    window.addEventListener(
      "mousemove",
      (event) => {

        mouse.x =
          (event.clientX /
            window.innerWidth -
            0.5);

        mouse.y =
          (event.clientY /
            window.innerHeight -
            0.5);


        gsap.to(
          ".scene",
          {
            rotationY:
              mouse.x * 12,

            rotationX:
              -mouse.y * 12,

            duration: 1.2,

            ease:
              "power3.out",

            overwrite: true,
          }
        );


        gsap.to(
          ".loader-logo",
          {
            x:
              mouse.x * 12,

            y:
              mouse.y * 8,

            duration: 1,

            ease:
              "power3.out",

            overwrite: true,
          }
        );

      }
    );


    /*
     * Finish loader
     */

    function finishLoader() {

      const timeline =
        gsap.timeline();


      /*
       * Core expands
       */

      timeline.to(
        ".scene",
        {
          scale: 2.8,

          opacity: 0,

          duration:
            0.9,

          ease:
            "power4.in",
        }
      );


      /*
       * Logo disappears
       */

      timeline.to(
        ".loader-logo",
        {
          y: -50,

          opacity: 0,

          duration:
            0.55,

          ease:
            "power3.in",
        },
        "<"
      );


      /*
       * Information disappears
       */

      timeline.to(
        ".loader-info",
        {
          opacity: 0,

          duration:
            0.3,
        },
        "<"
      );


      /*
       * Progress disappears
       */

      timeline.to(
        ".loader-progress-wrapper",
        {
          opacity: 0,

          duration:
            0.3,
        },
        "<"
      );


      /*
       * Screen reveal
       */

      timeline.to(
        loader,
        {
          clipPath:
            "inset(0% 0% 100% 0%)",

          duration:
            1.2,

          ease:
            "power4.inOut",

          onComplete: () => {

            loader.style.display =
              "none";


            window.dispatchEvent(
              new Event(
                "hepta-loader-complete"
              )
            );

          },

        }
      );

    }

  }


  /*
   * Initial page load
   */

  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      startLoader,
      {
        once: true,
      }
    );

  } else {

    startLoader();

  }


  /*
   * Astro navigation
   */

  document.addEventListener(
    "astro:page-load",
    startLoader
  );

</script>


<style>

  /* =========================================
     LOADER
  ========================================== */

  .loader {

    position: fixed;

    inset: 0;

    width: 100%;

    height: 100%;

    z-index: 99999;

    overflow: hidden;

    background:
      radial-gradient(
        circle at center,
        #111 0%,
        #070707 45%,
        #030303 100%
      );

    color: white;

    display: block;

    perspective: 1200px;

    will-change:
      clip-path;

    backface-visibility:
      hidden;

  }


  /* =========================================
     GRID
  ========================================== */

  .loader-grid {

    position: absolute;

    inset: -50%;

    background-image:
      linear-gradient(
        rgba(
          255,
          255,
          255,
          0.035
        ) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(
          255,
          255,
          255,
          0.035
        ) 1px,
        transparent 1px
      );

    background-size:
      80px 80px;

    transform:
      perspective(500px)
      rotateX(65deg)
      translateY(20%);

    transform-origin:
      center bottom;

    opacity: 0.6;

  }


  /* =========================================
     PARTICLES
  ========================================== */

  .particles {

    position: absolute;

    inset: 0;

    pointer-events: none;

  }


  .particles span {

    position: absolute;

    width: 2px;

    height: 2px;

    border-radius: 50%;

    background: white;

    opacity: 0.35;

    animation:
      particleFloat
      5s
      infinite
      ease-in-out;

  }


  .particles span:nth-child(1) {
    left: 12%;
    top: 20%;
  }

  .particles span:nth-child(2) {
    left: 23%;
    top: 70%;
    animation-delay: -2s;
  }

  .particles span:nth-child(3) {
    left: 35%;
    top: 30%;
    animation-delay: -1s;
  }

  .particles span:nth-child(4) {
    left: 48%;
    top: 15%;
    animation-delay: -3s;
  }

  .particles span:nth-child(5) {
    left: 65%;
    top: 25%;
    animation-delay: -2s;
  }

  .particles span:nth-child(6) {
    left: 80%;
    top: 45%;
    animation-delay: -4s;
  }

  .particles span:nth-child(7) {
    left: 15%;
    top: 50%;
    animation-delay: -1.5s;
  }

  .particles span:nth-child(8) {
    left: 30%;
    top: 85%;
    animation-delay: -3s;
  }

  .particles span:nth-child(9) {
    left: 72%;
    top: 75%;
    animation-delay: -2.5s;
  }

  .particles span:nth-child(10) {
    left: 88%;
    top: 20%;
    animation-delay: -1s;
  }

  .particles span:nth-child(11) {
    left: 55%;
    top: 80%;
    animation-delay: -4s;
  }

  .particles span:nth-child(12) {
    left: 90%;
    top: 85%;
    animation-delay: -3.5s;
  }


  @keyframes particleFloat {

    0%,
    100% {
      transform:
        translate3d(
          0,
          0,
          0
        );

      opacity: 0.15;
    }

    50% {
      transform:
        translate3d(
          0,
          -25px,
          20px
        );

      opacity: 0.7;
    }

  }


  /* =========================================
     INNER
  ========================================== */

  .loader-inner {

    position: relative;

    z-index: 2;

    width: 100%;

    height: 100%;

    padding:
      30px 40px;

    display: flex;

    flex-direction: column;

    justify-content:
      space-between;

  }


  /* =========================================
     TOP
  ========================================== */

  .loader-top {

    display: flex;

    justify-content:
      space-between;

    align-items: center;

    font-size: 9px;

    letter-spacing:
      0.2em;

  }


  .loader-brand {

    font-weight: 700;

  }


  .loader-status {

    opacity: 0.4;

  }


  .loader-status span {

    color: white;

    opacity: 1;

  }


  /* =========================================
     CENTER
  ========================================== */

  .loader-center {

    width:
      min(
        700px,
        80vw
      );

    margin:
      auto;

    position: relative;

  }


  /* =========================================
     3D SCENE
  ========================================== */

  .scene {

    width: 260px;

    height: 260px;

    margin:
      0 auto 20px;

    position: relative;

    transform-style:
      preserve-3d;

    perspective:
      1000px;

  }


  /* =========================================
     CORE
  ========================================== */

  .core {

    position: absolute;

    left: 50%;

    top: 50%;

    width: 150px;

    height: 150px;

    transform:
      translate(
        -50%,
        -50%
      );

    transform-style:
      preserve-3d;

  }


  /* =========================================
     SPHERE
  ========================================== */

  .core-sphere {

    position: absolute;

    left: 50%;

    top: 50%;

    width: 90px;

    height: 90px;

    transform:
      translate(
        -50%,
        -50%
      );

    border-radius: 50%;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.85
      );

    box-shadow:
      0 0 25px
      rgba(
        255,
        255,
        255,
        0.08
      );

    transform-style:
      preserve-3d;

  }


  .sphere-line {

    position: absolute;

    left: 50%;

    top: 50%;

    width: 100%;

    height: 100%;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.25
      );

    border-radius: 50%;

    transform:
      translate(
        -50%,
        -50%
      );

  }


  .line-1 {

    transform:
      translate(
        -50%,
        -50%
      )
      rotateX(60deg);

  }


  .line-2 {

    transform:
      translate(
        -50%,
        -50%
      )
      rotateY(60deg);

  }


  .line-3 {

    transform:
      translate(
        -50%,
        -50%
      )
      rotateX(-60deg);

  }


  .line-4 {

    transform:
      translate(
        -50%,
        -50%
      )
      rotateY(-60deg);

  }


  .sphere-dot {

    position: absolute;

    left: 50%;

    top: 50%;

    width: 7px;

    height: 7px;

    transform:
      translate(
        -50%,
        -50%
      );

    border-radius: 50%;

    background: white;

    box-shadow:
      0 0 20px
      rgba(
        255,
        255,
        255,
        0.9
      );

  }


  /* =========================================
     RINGS
  ========================================== */

  .core-ring {

    position: absolute;

    left: 50%;

    top: 50%;

    width: 150px;

    height: 150px;

    transform:
      translate(
        -50%,
        -50%
      );

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.25
      );

    border-radius: 50%;

    transform-style:
      preserve-3d;

  }


  .ring-1 {

    transform:
      translate(
        -50%,
        -50%
      )
      rotateX(65deg);

  }


  .ring-2 {

    transform:
      translate(
        -50%,
        -50%
      )
      rotateY(65deg);

  }


  .ring-3 {

    transform:
      translate(
        -50%,
        -50%
      )
      rotateZ(45deg)
      scale(1.15);

  }


  /* =========================================
     ORBITS
  ========================================== */

  .core-orbit {

    position: absolute;

    left: 50%;

    top: 50%;

    width: 190px;

    height: 70px;

    transform:
      translate(
        -50%,
        -50%
      );

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.18
      );

    border-radius: 50%;

  }


  .orbit-1 {

    transform:
      translate(
        -50%,
        -50%
      )
      rotateX(70deg);

  }


  .orbit-2 {

    transform:
      translate(
        -50%,
        -50%
      )
      rotateY(70deg);

  }


  /* =========================================
     GLOW
  ========================================== */

  .core-glow {

    position: absolute;

    left: 50%;

    top: 50%;

    width: 170px;

    height: 170px;

    transform:
      translate(
        -50%,
        -50%
      );

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(
          255,
          255,
          255,
          0.08
        ),
        transparent 65%
      );

    filter:
      blur(10px);

  }


  /* =========================================
     LOGO
  ========================================== */

  .loader-logo {

    text-align: center;

    font-size:
      clamp(
        70px,
        13vw,
        180px
      );

    line-height:
      0.8;

    letter-spacing:
      -0.09em;

    font-weight:
      500;

    margin-bottom:
      45px;

    will-change:
      transform,
      opacity;

  }


  /* =========================================
     PROGRESS
  ========================================== */

  .loader-progress-wrapper {

    width: 100%;

    height: 1px;

    background:
      rgba(
        255,
        255,
        255,
        0.15
      );

    overflow: hidden;

    transform-origin:
      center;

  }


  .loader-progress {

    width: 0%;

    height: 100%;

    background: white;

    transition:
      width 0.05s linear;

  }


  /* =========================================
     INFO
  ========================================== */

  .loader-info {

    display: flex;

    justify-content:
      space-between;

    margin-top: 15px;

    font-size: 8px;

    letter-spacing:
      0.18em;

  }


  /* =========================================
     BOTTOM
  ========================================== */

  .loader-bottom {

    display: flex;

    justify-content:
      space-between;

    align-items: center;

    font-size: 8px;

    letter-spacing:
      0.18em;

  }


  /* =========================================
     MOBILE
  ========================================== */

  @media (
    max-width: 768px
  ) {

    .loader-inner {

      padding:
        20px 25px;

    }


    .loader-grid {

      background-size:
        55px 55px;

    }


    .scene {

      width: 210px;

      height: 210px;

    }


    .core {

      transform:
        translate(
          -50%,
          -50%
        )
        scale(0.8);

    }


    .loader-logo {

      font-size:
        22vw;

      margin-bottom:
        35px;

    }


    .loader-bottom {

      flex-wrap: wrap;

      gap: 12px;

      line-height:
        1.5;

    }


    .loader-bottom span:nth-child(3) {

      display: none;

    }

  }


  /* =========================================
     REDUCED MOTION
  ========================================== */

  @media (
    prefers-reduced-motion: reduce
  ) {

    .particles span {

      animation: none;

    }

  }

</style>